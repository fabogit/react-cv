{
  "name": "my-cv-project",
  "version": "2.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:public": "vite --mode public",
    "build": "tsc -b && vite build",
    "build:private": "tsc -b && vite build --mode private",
    "generate:pdf": "node scripts/pdfGenerator.ts",
    "generate:pdf:private": "node scripts/pdfGenerator.ts --private",
    "lint": "oxlint",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "preview": "vite preview"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@myriaddreamin/typst-ts-node-compiler": "^0.7.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "oxfmt": "^0.78.0",
    "oxlint": "^1.93.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.8",
    "vite-plugin-compression": "^0.5.1"
  },
  "engines": {
    "node": ">=26.13.1",
    "pnpm": ">=11.21.0"
  },
  "packageManager": "pnpm@11.21.0"
}
